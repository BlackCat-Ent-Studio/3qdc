3qdc.wanmeivn.com {
	# 3q-hoi-dap: begin (wiki public + bot hoi dap; xem trien-khai/3q/RUNBOOK-40.md)
	redir /hoi-dap /hoi-dap/ 308
	redir /wiki /wiki/ 308
	handle_path /wiki/* {
		root * C:\app\3q-wiki\current
		file_server
	}
	handle /hoi-dap/* {
		reverse_proxy 127.0.0.1:8787
	}
	# 3q-hoi-dap: end
	# 3q-duyet: begin (trang duyet noi bo, mat khau; xem trien-khai/3q/RUNBOOK-40.md)
	redir /duyet /duyet/ 308
	handle_path /duyet/* {
		basic_auth {
			team3q <bcrypt-hash-in-secret-zip>
		}
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8788
	}
	# 3q-duyet: end
	handle {
		reverse_proxy localhost:3399 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	log {
		output file C:\caddy\logs\3qdc-wanmeivn-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

