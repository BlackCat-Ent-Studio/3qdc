# Old subdomain — 301 redirect to the new primary domain (lanaboutique.vn).
shopthoitrang.wanmeivn.com {
	redir https://lanaboutique.vn{uri} 301
	log {
		output file C:\caddy\logs\shopthoitrang-wanmeivn-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

lanaboutique.vn {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cache-Control "no-cache, must-revalidate"
	}

	@pcache query page_cache_dynamics_mods=1
	handle @pcache {
		header Content-Type application/json
		respond `{}` 200
	}

	@phpajax path *.php
	handle @phpajax {
		respond "" 200
	}

	@blog path /blog /blog/* /blog*.html
	handle @blog {
		redir https://lanaboutique.vn/ 302
	}

	handle {
		root * C:\web\web1\webthoitrang\kkfashion-mirror\www.kkfashion.vn
		file_server
	}

	handle_errors {
		@notfound_page {
			expression {err.status_code} == 404
			not path *.js *.css *.png *.jpg *.jpeg *.gif *.webp *.svg *.ico *.woff *.woff2 *.ttf *.eot *.json *.xml *.map *.txt *.mp4 *.webm
		}
		redir @notfound_page / 302
	}

	log {
		output file C:\caddy\logs\lanaboutique-vn-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

www.lanaboutique.vn {
	redir https://lanaboutique.vn{uri} 301
}

