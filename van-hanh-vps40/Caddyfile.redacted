tieu3q.wanmeivn.com {
	reverse_proxy https://160.191.3.41:9443 {
		header_up Host {host}
		transport http {
			tls
			tls_server_name tieu3q.wanmeivn.com
			tls_insecure_skip_verify
			read_timeout 24h
			write_timeout 24h
		}
	}
	log {
		output file C:\caddy\logs\tieu3q-wanmeivn-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

