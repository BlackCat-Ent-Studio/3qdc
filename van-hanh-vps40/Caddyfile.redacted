# hotro.wanmeivn.com — trang 5180 SkyStory (spine-viewer), tinh + mat khau. Dong bo: tools/deploy/dong-bo-hotro.sh (repo skystory)
hotro.wanmeivn.com {
	basic_auth {
		hotro <bcrypt-hash-in-secret-zip>
	}
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
	}
	handle_path /client/* {
		root * C:\app\hotro\client
		header Cache-Control "no-cache"
		file_server
	}
	handle_path /spine/* {
		root * C:\app\hotro\spine
		header Cache-Control "no-cache"
		file_server
	}
	handle_path /herobook/* {
		root * C:\app\hotro\herobook
		header Cache-Control "no-cache"
		file_server
	}
	handle_path /hslh/* {
		root * C:\app\hotro\hslh
		header Cache-Control "no-cache"
		file_server
	}
	handle_path /meomeo/* {
		root * C:\app\hotro\meomeo
		header Cache-Control "no-cache"
		file_server
	}
	# Black Moon: player skill-flow (base /blackmoon/) + kho asset cho nguon thu 3 cua Xem spine
	redir /blackmoon /blackmoon/ 308
	handle_path /blackmoon/* {
		root * C:\app\hotro\blackmoon
		header Cache-Control "no-cache"
		file_server
	}
	# (0929) bundle Vite co ma bam trong ten: doi noi dung = doi ten => giu 1 nam
	
handle /assets/* {
		root * C:\app\hotro\site
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	
handle {
		root * C:\app\hotro\site
		header Cache-Control "no-cache"
		# TAM (0929): xoa cache cu da ket trong trinh duyet (kho asset truoc day KHONG co
		# Cache-Control => trinh duyet tu doan giu ~6 ngay). GO 2 dong duoi sau ~06/10.
		header / Clear-Site-Data `"cache"`
		header /index.html Clear-Site-Data `"cache"`
		file_server
	}
	log {
		output file C:\caddy\logs\hotro-wanmeivn-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

3qdaichien.wanmeivn.com {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	# someone opening an article or the news list address directly lands on the one page, article open in its reader
	@artnav {
		path_regexp art ^/tin-tuc/([a-z0-9-]+)/?$
		header Sec-Fetch-Mode navigate
	}
	redir @artnav /#tin/{re.art.1} 302
	redir /tin-tuc /#tin-tuc 302
	redir /tin-tuc/ /#tin-tuc 302
	# news list, article pages (read by the page's script), uploaded pictures and artwork come from the 3qdc service
	@main path /api/tin-tuc /tin-tuc/* /tin-tuc-anh/* /3qdc-vi/*
	handle @main {
		reverse_proxy localhost:3399 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	# the page itself; nothing else of the 3qdc service (no /quan-tri) is reachable here
	handle {
		root * C:\app\3qdaichien\site
		header Cache-Control "no-cache"
		file_server
	}
	log {
		output file C:\caddy\logs\3qdaichien-wanmeivn-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

