	email tringuyen14071992@gmail.com
}

(bao-mat) {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

(nhat-ky) {
	log {
		output file /var/log/caddy/{args[0]}-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

3qdc.wanmeivn.com {
	import bao-mat
	import nhat-ky 3qdc-wanmeivn
	redir /hoi-dap /hoi-dap/ 308
	redir /wiki /wiki/ 308
	handle_path /wiki/* {
		root * /srv/3q-hoi-dap/wiki/current
		file_server
	}
	handle /hoi-dap/* {
		reverse_proxy 127.0.0.1:8787
	}
	redir /duyet /duyet/ 308
	handle_path /duyet/* {
		basic_auth {
			team3q <bcrypt-hash trong goi bi mat>
		}
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8788
	}
	handle {
		reverse_proxy localhost:3399 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

3qdaichien.wanmeivn.com {
	import bao-mat
	import nhat-ky 3qdaichien-wanmeivn
	@artnav {
		path_regexp art ^/tin-tuc/([a-z0-9-]+)/?$
		header Sec-Fetch-Mode navigate
	}
	redir @artnav /#tin/{re.art.1} 302
	redir /tin-tuc /#tin-tuc 302
	redir /tin-tuc/ /#tin-tuc 302
	@main path /api/tin-tuc /tin-tuc/* /tin-tuc-anh/* /3qdc-vi/*
	handle @main {
		reverse_proxy localhost:3399 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle {
		root * /srv/3qdaichien/site
		header Cache-Control "no-cache"
		file_server
	}
}

phieubengoan.3qdc.wanmeivn.com {
	import bao-mat
	import nhat-ky phieubengoan-wanmeivn
	reverse_proxy localhost:3399 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# === hotro.wanmeivn.com - cong cu noi bo SkyStory (trang 5180) - dung lai 16/10/2026 sau khi .40 cai Ubuntu ===
# nguon dong bo: tools/deploy/dong-bo-hotro.sh (repo skystory) -> /srv/hotro/<phan>
hotro.wanmeivn.com {
	import bao-mat
	import nhat-ky hotro-wanmeivn
	header X-Robots-Tag "noindex, nofollow"
	basic_auth {
		hotro <bcrypt-hash do nguoi phu trach hotro giu>
	}
	handle_path /client/* {
		root * /srv/hotro/client
		file_server
	}
	handle_path /spine/* {
		root * /srv/hotro/spine
		file_server
	}
	handle_path /herobook/* {
		root * /srv/hotro/herobook
		file_server
	}
	handle_path /hslh/* {
		root * /srv/hotro/hslh
		file_server
	}
	handle_path /meomeo/* {
		root * /srv/hotro/meomeo
		file_server
	}
	handle_path /blackmoon/* {
		root * /srv/hotro/blackmoon
		file_server
	}
	handle_path /sacduc/* {
		root * /srv/hotro/sacduc
		file_server
	}
	handle /assets/* {
		root * /srv/hotro/site
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/hotro/site
		header Cache-Control "no-cache"
		file_server
	}
}

shopluuniem.wanmeivn.com {
	import bao-mat
	import nhat-ky shopluuniem
	handle_path /img/* {
		root * /srv/shop-luu-niem/media
		header Cache-Control "public, max-age=604800"
		file_server
	}
	reverse_proxy 127.0.0.1:3010
}

xuongnoi.wanmeivn.com {
	root * /srv/xuong-noi/current
	encode zstd gzip
	file_server
}
import /etc/caddy/kartrider.caddy

# Trang chủ Thiên Không Kỳ Truyện (skystory) — trang tĩnh /srv/tkkt/site; game chơi trên web ở web.skystory.wanmeivn.com (VPS .23)
skystory.wanmeivn.com {
	import bao-mat
	import nhat-ky skystory-wanmeivn
	@anh path /assets/*
	header @anh Cache-Control "public, max-age=86400"
	# tin tức: danh sách + ảnh bài lấy từ máy chủ tin 3qdc-unified (nhận game theo Host)
	@tin-may-chu path /api/tin-tuc /api/nhac /nhac/* /tin-tuc-anh/*
	handle @tin-may-chu {
		reverse_proxy 127.0.0.1:3399
	}
	# thân bài: trang tin gọi /tin-tuc/<slug>?noi-dung=1 kèm header X-Tkkt: bai
	@bai {
		path /tin-tuc/*
		header X-Tkkt bai
	}
	handle @bai {
		reverse_proxy 127.0.0.1:3399
	}
	handle {
		root * /srv/tkkt/site
		header Cache-Control "no-cache"
		# người xem mở /tin-tuc hoặc /tin-tuc/<slug>: trang tin tĩnh, JS tự hiện danh sách / bài
		@trang-tin path /tin-tuc /tin-tuc/ /tin-tuc/*
		rewrite @trang-tin /tin-tuc.html
		file_server
	}
}


# Tiên Ma Vô Giới: trang chủ tĩnh đặt ở máy .21 (/opt/tienmavogioi/trang-chu).
# Khối này chỉ trả 5 đường API cho nginx .21 (Host tienmavogioi.com); chứng chỉ nội bộ, .21 tin root CA Caddy.
tienmavogioi.com, www.tienmavogioi.com {
	tls internal
	import bao-mat
	import nhat-ky tienmavogioi
	@ngoai not remote_ip 160.191.3.21 160.191.3.40 127.0.0.1
	handle @ngoai {
		respond 403
	}
	@api path /api/tin-tuc /api/bang-xep-hang /api/nhac /nhac/* /tin-tuc-anh/*
	handle @api {
		reverse_proxy 127.0.0.1:3399
	}
	handle {
		respond 404
	}
}
